@inject SignInManager<ApplicationUser> SignInManager
<div class="dashboard-panel p-3">
    <ul class="nav nav-pills flex-column gap-2">
        <li class="nav-item">
            <a class="nav-link @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "active bg-primary text-white" : "text-dark fw-bold")" id="profile" asp-page="./Index">Profile</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "active bg-primary text-white" : "text-dark fw-bold")" id="email" asp-page="./Email">Email</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "active bg-primary text-white" : "text-dark fw-bold")" id="change-password" asp-page="./ChangePassword">Password</a>
        </li>
    </ul>
</div>
