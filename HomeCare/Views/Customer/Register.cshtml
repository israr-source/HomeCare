@model HomeCare.ViewModels.CustomerRegisterViewModel

@{
    ViewData["Title"] = "Customer Registration";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-page">
    <div class="container">
        <div class="auth-shell">
            <div class="auth-intro">
                <span>Customer account</span>
                <h1>Book reliable home services in minutes.</h1>
                <p>
                    Create a customer profile to book services, monitor job progress, and review completed work.
                </p>

                <div class="auth-highlights">
                    <div>Browse service catalog</div>
                    <div>Track booking status</div>
                    <div>Review completed jobs</div>
                </div>
            </div>

            <div class="auth-card">
                <div class="auth-card-heading">
                    <span>Register as customer</span>
                    <h2>Create customer account</h2>
                    <p>Enter your details to start booking services.</p>
                </div>

                <form asp-action="Register">
                    <div asp-validation-summary="All" class="auth-validation"></div>

                    <div class="auth-field">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="Your full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Address" class="form-label">Address</label>
                        <input asp-for="Address" class="form-control" placeholder="Your service address" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Your phone number" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="password-field">
                            <input asp-for="Password" class="form-control" placeholder="Create a password" />
                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle
                                    aria-label="Show password">
                                Show
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="password-field">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" />
                            <button type="button"
                                    class="password-toggle"
                                    data-password-toggle
                                    aria-label="Show password">
                                Show
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn app-btn-primary auth-submit">
                        Register
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
