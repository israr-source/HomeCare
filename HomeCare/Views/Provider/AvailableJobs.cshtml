@model IEnumerable<HomeCare.Models.Booking>

@{
    ViewData["Title"] = "Available Jobs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Provider jobs</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Available Jobs</h1>
                    <p>Review pending booking requests and accept jobs that match your service area.</p>
                </div>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 8px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="dashboard-panel">
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Address</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Customer?.FullName</td>
                                    <td>@item.Service?.Name</td>
                                    <td>@item.Address</td>
                                    <td>@item.BookingDate</td>
                                    <td>
                                        <span class="dashboard-badge pending">@item.Status</span>
                                    </td>
                                    <td>
                                        <form asp-action="AcceptJob"
                                              asp-route-id="@item.Id"
                                              method="post">
                                            <button type="submit"
                                                    class="btn app-btn-primary btn-sm">
                                                Accept Job
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="dashboard-empty">
                                    No pending jobs available at this time.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
