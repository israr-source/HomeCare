@model IEnumerable<HomeCare.Models.Booking>

@{
    ViewData["Title"] = "Available Jobs";
}

<div class="container py-5">

    <h2 class="mb-4">
        Available Jobs
    </h2>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>
                <th>Customer</th>
                <th>Service</th>
                <th>Address</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.Customer?.FullName
                    </td>

                    <td>
                        @item.Service?.Name
                    </td>

                    <td>
                        @item.Address
                    </td>

                    <td>
                        @item.BookingDate
                    </td>

                    <td>
                        @item.Status
                    </td>

                    <td>

                        <form asp-action="AcceptJob"
                              asp-route-id="@item.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-success btn-sm">

                                Accept Job

                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>
