@model IEnumerable<HomeCare.Models.Booking>

@{
    ViewData["Title"] = "My Jobs";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Provider jobs</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>My Accepted Jobs</h1>
                    <p>Track accepted work and mark jobs as completed when finished.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Address</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Customer?.FullName</td>
                                <td>@item.Service?.Name</td>
                                <td>@item.Address</td>
                                <td>@item.BookingDate</td>
                                <td>
                                    @if (item.Status == "Accepted")
                                    {
                                        <span class="dashboard-badge accepted">@item.Status</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="dashboard-badge completed">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="dashboard-badge neutral">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Status == "Accepted")
                                    {
                                        <form asp-action="CompleteJob"
                                              asp-route-id="@item.Id"
                                              method="post">
                                            <button type="submit"
                                                    class="btn app-btn-primary btn-sm">
                                                Complete Job
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="dashboard-badge completed">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
