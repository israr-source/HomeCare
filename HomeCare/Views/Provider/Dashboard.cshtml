@model HomeCare.ViewModels.ProviderDashboardViewModel

@{
    ViewData["Title"] = "Provider Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Provider overview</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Provider Dashboard</h1>
                    <p>Monitor your jobs, track reviews, and manage your service work.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-stats-grid cols-3">
            <div class="dashboard-stat-card warning">
                <h3>Pending Jobs</h3>
                <strong>@Model.PendingJobs</strong>
            </div>

            <div class="dashboard-stat-card primary">
                <h3>Accepted Jobs</h3>
                <strong>@Model.AcceptedJobs</strong>
            </div>

            <div class="dashboard-stat-card success">
                <h3>Completed Jobs</h3>
                <strong>@Model.CompletedJobs</strong>
            </div>
        </div>

        <div class="dashboard-stats-grid cols-2">
            <div class="dashboard-stat-card">
                <h3>Total Reviews</h3>
                <strong>@Model.TotalReviews</strong>
            </div>

            <div class="dashboard-stat-card primary">
                <h3>Average Rating</h3>
                <strong>@Model.AverageRating.ToString("0.0") ⭐</strong>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <span>Quick actions</span>
                    <h2>Manage your work</h2>
                </div>
            </div>

            <div class="dashboard-actions">
                <a asp-action="AvailableJobs"
                   class="btn app-btn-primary">
                    Available Jobs
                </a>

                <a asp-action="MyJobs"
                   class="btn app-btn-outline">
                    My Jobs
                </a>

                <a asp-action="Reviews"
                   class="btn app-btn-outline">
                    My Reviews
                </a>
            </div>
        </div>
    </div>
</section>
