@model HomeCare.ViewModels.ProviderDashboardViewModel

@{
    ViewData["Title"] = "Provider Dashboard";
}

<div class="container py-5">

    <h2 class="mb-4">
        Provider Dashboard
    </h2>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5>Pending Jobs</h5>

                    <h2>@Model.PendingJobs</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5>Accepted Jobs</h5>

                    <h2>@Model.AcceptedJobs</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5>Completed Jobs</h5>

                    <h2>@Model.CompletedJobs</h2>

                </div>

            </div>

        </div>

    </div>

    <div class="row g-4 mt-2">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5>Total Reviews</h5>

                    <h2>@Model.TotalReviews</h2>

                </div>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h5>Average Rating</h5>

                    <h2>@Model.AverageRating.ToString("0.0") ⭐</h2>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-5">

        <h4>Quick Actions</h4>

        <div class="mt-3">

            <a asp-action="AvailableJobs"
               class="btn btn-primary me-2">
                Available Jobs
            </a>

            <a asp-action="MyJobs"
               class="btn btn-success me-2">
                My Jobs
            </a>

            <a asp-action="Reviews"
               class="btn btn-warning">
                My Reviews
            </a>

        </div>

    </div>

</div>