@model HomeCare.ViewModels.ProviderProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Provider settings</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>My Profile</h1>
                    <p>Update your personal information and service category.</p>
                </div>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 8px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;">
                @TempData["SuccessMessage"]
            </div>
        }

        <div class="dashboard-panel" style="max-width: 600px; margin: 0;">
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 1rem;"></div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label asp-for="Email" class="form-label" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Email (Read-only)</label>
                    <input asp-for="Email" class="form-control" readonly style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; background-color: #f8f9fa;" />
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label asp-for="FullName" class="form-label" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Full Name</label>
                    <input asp-for="FullName" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px;" />
                    <span asp-validation-for="FullName" class="text-danger" style="color: #dc3545; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label asp-for="PhoneNumber" class="form-label" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px;" />
                    <span asp-validation-for="PhoneNumber" class="text-danger" style="color: #dc3545; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 1rem;">
                    <label asp-for="Address" class="form-label" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Address</label>
                    <input asp-for="Address" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px;" />
                    <span asp-validation-for="Address" class="text-danger" style="color: #dc3545; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <div class="form-group" style="margin-bottom: 1.5rem;">
                    <label asp-for="ServiceType" class="form-label" style="display:block; margin-bottom: 0.5rem; font-weight: 500;">Service Category</label>
                    
                    @{
                        var categories = ViewBag.Categories as SelectList;
                        bool hasCategories = categories != null && categories.Any();
                    }

                    @if (!hasCategories)
                    {
                        <div class="alert alert-warning" style="margin-bottom: 0.5rem; padding: 0.75rem; border-radius: 4px; background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; font-size: 0.875rem;">
                            No service categories are available. Please contact an administrator.
                        </div>
                    }

                    <select asp-for="ServiceType" 
                            asp-items="categories" 
                            class="form-select" 
                            disabled="@(!hasCategories ? "disabled" : null)"
                            style="width: 100%; padding: 0.75rem; border: 1px solid #ddd; border-radius: 8px; background-color: white;">
                        <option value="">-- Select a Category --</option>
                    </select>
                    <span asp-validation-for="ServiceType" class="text-danger" style="color: #dc3545; font-size: 0.875rem; margin-top: 0.25rem; display: block;"></span>
                </div>

                <button type="submit" class="btn app-btn-primary" style="padding: 0.75rem 1.5rem; border-radius: 8px;">
                    Save Changes
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
