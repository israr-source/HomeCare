@model HomeCare.Models.Service

@{
    ViewData["Title"] = "Delete Service";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1 style="color: var(--hc-danger-text);">Delete Service</h1>
                    <p>Are you sure you want to delete this service?</p>
                </div>
            </div>
        </div>

        <div class="dashboard-panel">
            <h2 class="mb-4">@Model.Name</h2>
            <div class="mb-3">
                <strong>Category:</strong> @Model.ServiceCategory?.Name
            </div>
            <div class="mb-3">
                <strong>Price:</strong> BDT @Model.Price
            </div>
            <div class="mb-4">
                <strong>Description:</strong> @Model.Description
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                
                <div class="hc-form-actions">
                    <button type="submit" class="btn btn-outline-danger">
                        Confirm Delete
                    </button>

                    <a asp-action="Index" class="btn app-btn-outline">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>
