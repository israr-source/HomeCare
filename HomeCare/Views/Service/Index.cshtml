@model IEnumerable<HomeCare.Models.Service>

@{
    ViewData["Title"] = "Services";
}

@section Styles {
    <link rel="stylesheet" href="~/css/service.css" asp-append-version="true" />
}

<section class="service-hero">
    <div class="container">
        <div class="service-hero-content">
            <span>HomeCare services</span>
            <h1>Find the right professional for your home.</h1>
            <p>
                Search trusted home services, compare pricing, and book the service
                that fits your schedule.
            </p>
        </div>
    </div>
</section>

<section class="service-catalog">
    <div class="container">
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-danger" style="margin-top: 1rem; border-radius: 8px;">
                @TempData["StatusMessage"]
            </div>
        }

        <form method="get" class="service-filter">
            <div class="filter-field">
                <label for="searchTerm">Search services</label>
                <input id="searchTerm"
                       type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search cleaning, plumbing, AC repair..." />
            </div>

            <div class="filter-field">
                <label for="categoryId">Category</label>
                <select id="categoryId"
                        name="categoryId"
                        class="form-select">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in ViewBag.Categories)
                    {
                        if (ViewBag.CategoryId != null && ViewBag.CategoryId == category.Id)
                        {
                            <option value="@category.Id" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>
            </div>

            <div class="filter-actions">
                <button type="submit"
                        class="btn app-btn-primary">
                    Search
                </button>

                <a asp-action="Index"
                   class="btn app-btn-outline">
                    Clear
                </a>
            </div>
        </form>

        <div class="catalog-header">
            <div>
                <span>@Model.Count() services found</span>
                <h2>Available services</h2>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create"
                   class="btn app-btn-primary">
                    Add Service
                </a>
            }
        </div>

        @if (Model.Any())
        {
            <div class="service-card-grid">
                @foreach (var item in Model)
                {
                    <article class="catalog-service-card">
                        <div class="card-top">
                            <span class="category-badge">
                                @item.ServiceCategory?.Name
                            </span>

                            <strong class="service-price">
                                BDT @item.Price
                            </strong>
                        </div>

                        <h3>@item.Name</h3>

                        <p>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                @(item.Description.Length > 140
                                    ? item.Description.Substring(0, 140) + "..."
                                    : item.Description)
                            }
                            else
                            {
                                <span>Professional home service available through HomeCare.</span>
                            }
                        </p>

                        <div class="service-actions">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn app-btn-outline">
                                View Details
                            </a>

                            <a asp-controller="Booking"
                               asp-action="Create"
                               asp-route-serviceId="@item.Id"
                               class="btn app-btn-primary">
                                Book Now
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn app-btn-outline"
                                   style="width:100%;">
                                    Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger"
                                   style="width:100%;">
                                    Delete
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="service-empty-state">
                <span>No services found</span>
                <h3>Try adjusting your search or category filter.</h3>
                <p>
                    When admins add services to the catalog, customers can browse and book them here.
                </p>

                <a asp-action="Index"
                   class="btn app-btn-primary">
                    View All Services
                </a>
            </div>
        }
    </div>
</section>
