@model HomeCare.Models.Service

@{
    ViewData["Title"] = "Create Service";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-4">
                        Create Service
                    </h2>

                    <form asp-action="Create">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Service Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control">
                            </textarea>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Price
                            </label>

                            <input asp-for="Price"
                                   class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Category
                            </label>

                            <select asp-for="ServiceCategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select">

                                <option value="">
                                    -- Select Category --
                                </option>

                            </select>

                        </div>

                        <button type="submit"
                                class="btn btn-primary">

                            Create Service

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}