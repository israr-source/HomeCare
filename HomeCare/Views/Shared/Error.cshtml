@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="hc-content-page">
    <div class="container">
        <div class="hc-content-panel">
            <span class="hc-eyebrow">Something went wrong</span>
            <h1 class="hc-danger-title hc-page-title">Error</h1>
            <p class="hc-page-lead">
                An error occurred while processing your request.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="hc-field">
                    <label class="form-label">Request ID</label>
                    <code>@Model.RequestId</code>
                </div>
            }

            <div class="hc-form-actions">
                <a asp-controller="Home" asp-action="Index" class="btn app-btn-primary">
                    Return Home
                </a>
            </div>

            <hr class="my-4" />

            <h2 class="h5">Development Mode</h2>
            <p class="hc-page-lead">
                Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
            </p>
            <p class="hc-page-lead">
                <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                It can result in displaying sensitive information from exceptions to end users.
                For local debugging, enable the <strong>Development</strong> environment by setting the
                <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to <strong>Development</strong>
                and restarting the app.
            </p>
        </div>
    </div>
</section>
