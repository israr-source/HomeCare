<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HomeCare.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">

                <a class="navbar-brand app-brand" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark">HC</span>
                    <span>HomeCare</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent"
                        aria-controls="navbarContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Service" asp-action="Index">
                                Services
                            </a>
                        </li>

                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>
        </nav>
    </header>
    <div class="app-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">

        <div class="container">

            <div class="row g-4 align-items-start">

                <div class="col-md-5">

                    <div class="app-footer-brand">
                        HomeCare
                    </div>

                    <p class="app-footer-text">
                        A trusted home-service marketplace for booking reliable professionals quickly and confidently.
                    </p>

                </div>

                <div class="col-md-3">

                    <h6 class="app-footer-title">Explore</h6>

                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Service" asp-action="Index">Services</a>
                    <a asp-controller="Account" asp-action="RegisterOptions">Register</a>

                </div>

                <div class="col-md-4">

                    <h6 class="app-footer-title">Why HomeCare</h6>

                    <p class="app-footer-text">
                        Simple booking, role-based dashboards, provider job tracking, and customer reviews in one platform.
                    </p>

                </div>

            </div>

            <div class="app-footer-bottom">
                &copy; 2026 HomeCare. All rights reserved.
            </div>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
