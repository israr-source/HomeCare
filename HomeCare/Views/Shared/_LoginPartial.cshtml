@using Microsoft.AspNetCore.Identity
@using HomeCare.Models.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-lg-2">

    @if (SignInManager.IsSignedIn(User))
    {
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">

                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                    Dashboard
                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link" asp-controller="Admin" asp-action="Users">
                    Users
                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link" asp-controller="Admin" asp-action="Bookings">
                    Bookings
                </a>

            </li>
        }
        else if (User.IsInRole("Customer"))
        {
            <li class="nav-item">

                <a class="nav-link" asp-controller="Customer" asp-action="Dashboard">
                    Dashboard
                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link" asp-controller="Booking" asp-action="Index">
                    My Bookings
                </a>

            </li>
        }
        else if (User.IsInRole("Provider"))
        {
            <li class="nav-item">

                <a class="nav-link" asp-controller="Provider" asp-action="Dashboard">
                    Dashboard
                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link" asp-controller="Provider" asp-action="AvailableJobs">
                    Available Jobs
                </a>

            </li>

            <li class="nav-item">

                <a class="nav-link" asp-controller="Provider" asp-action="MyJobs">
                    My Jobs
                </a>

            </li>
        }

        <li class="nav-item">

            <a id="manage"
               class="nav-link app-user-link"
               asp-area="Identity"
               asp-page="/Account/Manage/Index"
               title="Manage">

                Hello @UserManager.GetUserName(User)!

            </a>

        </li>

        <li class="nav-item">

            <form id="logoutForm"
                  class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">

                <button id="logout"
                        type="submit"
                        class="btn app-btn-outline">

                    Logout

                </button>

            </form>

        </li>
    }
    else
    {
        <li class="nav-item">

            <a class="btn app-btn-ghost"
               id="register"
               asp-controller="Account"
               asp-action="RegisterOptions">

                Register

            </a>

        </li>

        <li class="nav-item">

            <a class="btn app-btn-primary"
               id="login"
               asp-area="Identity"
               asp-page="/Account/Login">

                Login

            </a>

        </li>
    }

</ul>
