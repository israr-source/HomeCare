@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid p-0">

    <!-- Hero Section -->
    <div class="bg-primary text-white text-center py-5">
        <div class="container">
            <h1 class="display-4 fw-bold">Welcome to HomeCare</h1>

            <p class="lead mt-3">
                Book trusted home services anytime, anywhere.
            </p>

            <a href="#" class="btn btn-light btn-lg mt-3">
                Explore Services
            </a>
        </div>
    </div>

    <!-- Services Section -->
    <div class="container py-5">

        <h2 class="text-center mb-5">
            Our Services
        </h2>

        <div class="row g-4">

            <div class="col-md-3">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body">
                        <h4>Electrician</h4>
                        <p>Professional electrical repair services.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body">
                        <h4>Plumbing</h4>
                        <p>Reliable plumbing solutions for your home.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body">
                        <h4>Cleaning</h4>
                        <p>Expert home and office cleaning services.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card shadow-sm h-100 text-center">
                    <div class="card-body">
                        <h4>AC Repair</h4>
                        <p>Fast and affordable AC maintenance.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Why Choose Us -->
    <div class="bg-light py-5">

        <div class="container">

            <h2 class="text-center mb-5">
                Why Choose HomeCare?
            </h2>

            <div class="row text-center">

                <div class="col-md-4">
                    <h4>Trusted Professionals</h4>
                    <p>Verified and skilled service providers.</p>
                </div>

                <div class="col-md-4">
                    <h4>Quick Booking</h4>
                    <p>Book services easily within minutes.</p>
                </div>

                <div class="col-md-4">
                    <h4>24/7 Support</h4>
                    <p>We are always here to help you.</p>
                </div>

            </div>

        </div>
    </div>

</div>