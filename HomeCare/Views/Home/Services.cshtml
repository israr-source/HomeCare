@{
    ViewData["Title"] = "Services";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="fw-bold">Our Services</h1>

        <p class="text-muted">
            Explore professional home services offered by HomeCare.
        </p>
    </div>

    <div class="row g-4">

        <!-- Electrician -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Electrician
                    </h4>

                    <p class="card-text">
                        Professional electrical installation and repair services.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Book Now
                    </a>

                </div>

            </div>
        </div>

        <!-- Plumbing -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Plumbing
                    </h4>

                    <p class="card-text">
                        Reliable plumbing maintenance and pipe repair services.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Book Now
                    </a>

                </div>

            </div>
        </div>

        <!-- Cleaning -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Cleaning
                    </h4>

                    <p class="card-text">
                        Expert home and office cleaning solutions.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Book Now
                    </a>

                </div>

            </div>
        </div>

        <!-- AC Repair -->
        <div class="col-md-3">
            <div class="card shadow-sm h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        AC Repair
                    </h4>

                    <p class="card-text">
                        Affordable AC servicing and maintenance support.
                    </p>

                    <a href="#" class="btn btn-primary">
                        Book Now
                    </a>

                </div>

            </div>
        </div>

    </div>

</div>