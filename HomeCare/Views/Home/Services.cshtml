@{
    ViewData["Title"] = "Services";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/service.css" asp-append-version="true" />
}

<section class="home-hero">
    <div class="container">
        <span class="hero-eyebrow">Our services</span>
        <h1>Professional home services for every need.</h1>
        <p class="hero-text">
            Explore popular home-care categories or browse the full service catalog.
        </p>

        <div class="hero-actions">
            <a asp-controller="Service" asp-action="Index" class="btn app-btn-primary">
                Browse Full Catalog
            </a>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="container">
        <div class="service-card-grid">
            <article class="catalog-service-card">
                <div class="card-top">
                    <span class="category-badge">Electrical</span>
                </div>
                <h3>Electrician</h3>
                <p>Professional electrical installation and repair services.</p>
                <div class="service-actions">
                    <a asp-controller="Service" asp-action="Index" class="btn app-btn-primary">
                        View Services
                    </a>
                </div>
            </article>

            <article class="catalog-service-card">
                <div class="card-top">
                    <span class="category-badge">Plumbing</span>
                </div>
                <h3>Plumbing</h3>
                <p>Reliable plumbing maintenance and pipe repair services.</p>
                <div class="service-actions">
                    <a asp-controller="Service" asp-action="Index" class="btn app-btn-primary">
                        View Services
                    </a>
                </div>
            </article>

            <article class="catalog-service-card">
                <div class="card-top">
                    <span class="category-badge">Cleaning</span>
                </div>
                <h3>Cleaning</h3>
                <p>Expert home and office cleaning solutions.</p>
                <div class="service-actions">
                    <a asp-controller="Service" asp-action="Index" class="btn app-btn-primary">
                        View Services
                    </a>
                </div>
            </article>

            <article class="catalog-service-card">
                <div class="card-top">
                    <span class="category-badge">HVAC</span>
                </div>
                <h3>AC Repair</h3>
                <p>Affordable AC servicing and maintenance support.</p>
                <div class="service-actions">
                    <a asp-controller="Service" asp-action="Index" class="btn app-btn-primary">
                        View Services
                    </a>
                </div>
            </article>
        </div>
    </div>
</section>
