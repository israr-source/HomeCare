@{
    ViewData["Title"] = "Register";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<section class="auth-page">
    <div class="container">
        <div class="auth-heading">
            <span>Create your account</span>
            <h1>How would you like to use HomeCare?</h1>
            <p>
                Choose the account type that matches your role in the home-service marketplace.
            </p>
        </div>

        <div class="register-option-grid">
            <article class="register-option-card">
                <div class="option-icon">C</div>
                <span>For customers</span>
                <h2>Book home services</h2>
                <p>
                    Browse services, submit booking requests, track status, and review completed jobs.
                </p>

                <ul>
                    <li>Search services by category</li>
                    <li>Manage your bookings</li>
                    <li>Leave provider reviews</li>
                </ul>

                <a asp-controller="Customer"
                   asp-action="Register"
                   class="btn app-btn-primary">
                    Register as Customer
                </a>
            </article>

            <article class="register-option-card featured">
                <div class="option-icon">P</div>
                <span>For providers</span>
                <h2>Offer your services</h2>
                <p>
                    Join HomeCare as a provider, accept jobs, complete work, and build customer trust.
                </p>

                <ul>
                    <li>View available jobs</li>
                    <li>Track accepted work</li>
                    <li>Receive customer reviews</li>
                </ul>

                <a asp-controller="Provider"
                   asp-action="Register"
                   class="btn app-btn-primary">
                    Register as Provider
                </a>
            </article>
        </div>

        <div class="auth-switch">
            Already have an account?
            <a asp-area="Identity" asp-page="/Account/Login">
                Log in
            </a>
        </div>
    </div>
</section>
