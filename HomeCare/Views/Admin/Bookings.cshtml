@model IEnumerable<HomeCare.Models.Booking>

@{
    ViewData["Title"] = "All Bookings";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Booking Management</h1>
                    <p>Monitor booking activity and status across the HomeCare platform.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-stats-grid cols-3">
            <div class="dashboard-stat-card warning">
                <h3>Pending Bookings</h3>
                <strong>@ViewBag.PendingCount</strong>
            </div>

            <div class="dashboard-stat-card primary">
                <h3>Accepted Bookings</h3>
                <strong>@ViewBag.AcceptedCount</strong>
            </div>

            <div class="dashboard-stat-card success">
                <h3>Completed Bookings</h3>
                <strong>@ViewBag.CompletedCount</strong>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Service</th>
                            <th>Address</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td>@booking.Customer?.FullName</td>
                                    <td>@booking.Service?.Name</td>
                                    <td>@booking.Address</td>
                                    <td>@booking.BookingDate</td>
                                    <td>
                                        @if (booking.Status == "Pending")
                                        {
                                            <span class="dashboard-badge pending">Pending</span>
                                        }
                                        else if (booking.Status == "Accepted")
                                        {
                                            <span class="dashboard-badge accepted">Accepted</span>
                                        }
                                        else if (booking.Status == "Completed")
                                        {
                                            <span class="dashboard-badge completed">Completed</span>
                                        }
                                        else
                                        {
                                            <span class="dashboard-badge neutral">@booking.Status</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="dashboard-empty">
                                    No bookings found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
