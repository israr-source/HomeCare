@model HomeCare.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Admin overview</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Admin Dashboard</h1>
                    <p>Monitor platform activity, users, services, and booking performance.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-stats-grid cols-3">
            <div class="dashboard-stat-card">
                <h3>Total Customers</h3>
                <strong>@Model.TotalCustomers</strong>
            </div>

            <div class="dashboard-stat-card">
                <h3>Total Providers</h3>
                <strong>@Model.TotalProviders</strong>
            </div>

            <div class="dashboard-stat-card primary">
                <h3>Total Services</h3>
                <strong>@Model.TotalServices</strong>
            </div>

            <div class="dashboard-stat-card">
                <h3>Total Bookings</h3>
                <strong>@Model.TotalBookings</strong>
            </div>

            <div class="dashboard-stat-card success">
                <h3>Completed Jobs</h3>
                <strong>@Model.CompletedBookings</strong>
            </div>

            <div class="dashboard-stat-card">
                <h3>Total Reviews</h3>
                <strong>@Model.TotalReviews</strong>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <span>Administration</span>
                    <h2>Platform management</h2>
                </div>
            </div>

            <div class="dashboard-actions">
                <a asp-action="Users"
                   class="btn app-btn-primary">
                    Manage Users
                </a>

                <a asp-action="Bookings"
                   class="btn app-btn-outline">
                    View Bookings
                </a>
            </div>
        </div>
    </div>
</section>
