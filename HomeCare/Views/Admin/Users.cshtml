@model IEnumerable<HomeCare.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="container py-5">

    <h2 class="mb-4">
        System Users
    </h2>

    <form method="get" class="mb-4">

        <div class="row">

            <div class="col-md-6">

                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by name or email..." />

            </div>

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary w-100">

                    Search

                </button>

            </div>

            <div class="col-md-2">

                <a asp-action="Users"
                   class="btn btn-secondary w-100">

                    Clear

                </a>

            </div>

        </div>

    </form>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>

        </thead>

        <tbody>

            @if (Model.Any())
            {
                @foreach (var user in Model)
                {
                    <tr>

                        <td>@user.FullName</td>

                        <td>@user.Email</td>

                        <td>@user.Role</td>

                    </tr>
                }
            }
            else
            {
                <tr>

                    <td colspan="3" class="text-center">

                        No users found.

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>