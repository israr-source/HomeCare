@model IEnumerable<HomeCare.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>System Users</h1>
                    <p>Search and review registered customers, providers, and administrators.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-panel">
            <form method="get" class="dashboard-search">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search by name or email..." />

                <button type="submit"
                        class="btn app-btn-primary">
                    Search
                </button>

                <a asp-action="Users"
                   class="btn app-btn-outline">
                    Clear
                </a>
            </form>

            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <span class="dashboard-badge neutral">@user.Role</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="dashboard-empty">
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
