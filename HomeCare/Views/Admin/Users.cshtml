@model IEnumerable<HomeCare.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="container py-5">

    <h2 class="mb-4">
        System Users
    </h2>

    <table class="table table-bordered table-striped">

        <thead>

            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var user in Model)
            {
                <tr>

                    <td>@user.FullName</td>

                    <td>@user.Email</td>

                    <td>@user.Role</td>

                </tr>
            }

        </tbody>

    </table>

</div>