@model IEnumerable<HomeCare.Models.ServiceCategory>

@{
    ViewData["Title"] = "Categories";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Service Categories</h1>
                    <p>Manage the categories used to organize the HomeCare service catalog.</p>
                </div>

                <a asp-action="Create" class="btn app-btn-primary">
                    Add Category
                </a>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="dashboard-table-wrap">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <div class="dashboard-actions">
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn app-btn-outline btn-sm">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-danger btn-sm">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="dashboard-empty">
                                    No categories found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
