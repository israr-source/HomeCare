@model HomeCare.Models.ServiceCategory

@{
    ViewData["Title"] = "Delete Category";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1 class="hc-danger-title">Delete Category</h1>
                    <p>This action cannot be undone. Confirm that you want to remove this category.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-panel hc-form-layout hc-danger-panel">
            <div class="hc-field">
                <span class="hc-eyebrow">Category</span>
                <h2 class="hc-page-title">@Model.Name</h2>
                <p class="hc-page-lead">@Model.Description</p>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />

                <div class="hc-form-actions">
                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>

                    <a asp-action="Index" class="btn app-btn-outline">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>
