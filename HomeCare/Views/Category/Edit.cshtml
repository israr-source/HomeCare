@model HomeCare.Models.ServiceCategory

@{
    ViewData["Title"] = "Edit Category";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<section class="dashboard-page">
    <div class="container">
        <div class="dashboard-heading">
            <span>Administration</span>
            <div class="dashboard-heading-row">
                <div>
                    <h1>Edit Category</h1>
                    <p>Update the category name and description.</p>
                </div>
            </div>
        </div>

        <div class="dashboard-panel hc-form-layout">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="All" class="hc-validation"></div>

                <div class="hc-field">
                    <label asp-for="Name" class="form-label">Category Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="hc-field">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control"></textarea>
                </div>

                <div class="hc-form-actions">
                    <button type="submit" class="btn app-btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index" class="btn app-btn-outline">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
